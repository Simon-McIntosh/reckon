    "tier": {
      "default": "",
      "deprecated": true,
      "description": "Deprecated compatibility input; use capability",
      "title": "Tier",
      "type": "string"
    },
    "owner": {
      "default": "",
      "title": "Owner",
      "type": "string"
    },
    "archived": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archived"
    },
    "read": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Read"
