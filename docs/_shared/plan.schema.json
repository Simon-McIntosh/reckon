    "reviewed_at": {
      "default": "",
      "title": "Reviewed At",
      "type": "string"
    },
    "recorded_at": {
      "default": "",
      "title": "Recorded At",
      "type": "string"
    },
    "verdict": {
      "default": "",
      "title": "Verdict",
      "type": "string"
    },
    "environment": {
      "default": "",
      "title": "Environment",
      "type": "string"
    },
    "source": {
