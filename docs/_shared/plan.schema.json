{
  "$defs": {
    "CapabilityRequest": {
      "additionalProperties": false,
      "description": "Versioned, provider-neutral capability request persisted with work.",
      "properties": {
        "version": {
          "const": "1.0",
          "default": "1.0",
          "type": "string"
        },
        "class": {
          "default": "general",
          "enum": [
            "routine",
            "general",
            "orchestrator"
          ],
          "type": "string"
        },
        "requirements": {
          "$ref": "#/$defs/CapabilityRequirements"
        }
      },
      "type": "object"
    },
    "CapabilityRequirements": {
      "additionalProperties": false,
      "description": "Structured hard floors that complement the broad capability class.",
      "properties": {
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "enum": [
            "standard",
            "deep",
            null
          ]
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "enum": [
            "standard",
            "extended",
            null
          ]
        },
        "tool_autonomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "enum": [
            "guided",
            "autonomous",
            null
          ]
        },
        "verification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "enum": [
            "standard",
            "strict",
            null
          ]
        },
        "risk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "enum": [
            "low",
            "moderate",
            "elevated",
            "critical",
            null
          ]
        }
      },
      "type": "object"
    },
    "Comment": {
      "description": "A comment (``.r-comment`` element). Anchored to a section via the dict\nkey (default ``_top``) \u2014 the anchor is the mapping key, not a field here.",
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "who": {
          "default": "",
          "type": "string"
        },
        "when": {
          "default": "",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "body": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Decision": {
      "description": "A single decision (``.r-dec`` element). Keyed by ``data-key`` in the\nplan's ``decisions`` dict \u2014 the key lives in the mapping, not here.\n\n``choice == \"\"`` means open. ``chosen`` is intentionally absent: the SPA's\nlist view derives it from ``choice``; storing it would be redundant.",
      "properties": {
        "title": {
          "default": "",
          "type": "string"
        },
        "context": {
          "default": "",
          "type": "string"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "option_labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "choice": {
          "default": "",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "type": "string"
        },
        "when": {
          "default": "",
          "type": "string"
        },
        "by": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Followup": {
      "description": "A followup (``.r-fu`` element). ``status`` mirrors read_state's value;\nwrite_state re-derives ``data-status`` from ``resolved_at`` on render.\n\n``resolved_at`` / ``resolved_by`` / ``outcome`` are present in the dict only\nwhen the followup is resolved \u2014 they MUST stay unset otherwise so\n``exclude_unset`` reproduces read_state's conditional shape.",
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "status": {
          "default": "open",
          "type": "string"
        },
        "capability": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tier": {
          "default": "",
          "deprecated": true,
          "description": "Deprecated compatibility input; use capability",
          "type": "string"
        },
        "written_by": {
          "default": "",
          "type": "string"
        },
        "written_at": {
          "default": "",
          "type": "string"
        },
        "recommends_skill": {
          "default": "",
          "type": "string"
        },
        "title": {
          "default": "",
          "type": "string"
        },
        "body": {
          "default": "",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "type": "string"
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "Gate": {
      "description": "An evidence or transition gate; passed derives from verdict.",
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "section": {
          "default": "",
          "type": "string"
        },
        "gated_sections": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "transition": {
          "default": "",
          "enum": [
            "",
            "plan-terminal",
            "decision-lockable"
          ],
          "type": "string"
        },
        "gating_plan": {
          "default": "",
          "description": "Outcome source: [project:]slug[#section]",
          "type": "string"
        },
        "decision": {
          "default": "",
          "description": "Decision key for a decision-lockable edge",
          "type": "string"
        },
        "status": {
          "default": "",
          "type": "string"
        },
        "measure": {
          "type": "string"
        },
        "required_evidence": {
          "default": "",
          "type": "string"
        },
        "verdict": {
          "default": "",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "type": "string"
        },
        "passed": {
          "default": false,
          "readOnly": true,
          "type": "boolean"
        }
      },
      "required": [
        "measure"
      ],
      "type": "object"
    },
    "Question": {
      "description": "A question (``.r-q`` element). No ``status`` *field* \u2014 read_state omits it\nfrom question dicts. Use the :attr:`status` property for views; a Pydantic\nfield (or computed_field) would force-include it and break the round-trip.",
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "section": {
          "default": "",
          "type": "string"
        },
        "opened_by": {
          "default": "",
          "type": "string"
        },
        "opened_at": {
          "default": "",
          "type": "string"
        },
        "body": {
          "default": "",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "ResearchItem": {
      "description": "A research entry (``.r-research`` element).",
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "type": {
          "default": "",
          "type": "string"
        },
        "title": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "added_by": {
          "default": "",
          "type": "string"
        },
        "when": {
          "default": "",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "SectionRecord": {
      "additionalProperties": false,
      "description": "Typed metadata carried by an h2 or its adjacent data-reckon element.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "effort_hours": {
          "exclusiveMinimum": 0,
          "multipleOf": 0.25,
          "type": "number"
        },
        "capability": {
          "$ref": "#/$defs/CapabilityRequest",
          "allOf": [
            {
              "properties": {
                "requirements": {
                  "properties": {
                    "reasoning": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "verification": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "risk": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "reasoning",
                    "verification",
                    "risk"
                  ]
                }
              },
              "required": [
                "requirements"
              ]
            }
          ]
        },
        "attempts": {
          "description": "Tool-owned launch count",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "implementable",
            "deferred",
            "done"
          ],
          "type": "string"
        },
        "links": {
          "description": "Plan refs, using [project:]slug[#section]",
          "items": {
            "pattern": "^\\s*(?:[A-Za-z0-9][A-Za-z0-9_-]*:)?[A-Za-z0-9][A-Za-z0-9._-]*(?:#[A-Za-z0-9][A-Za-z0-9._-]*)?\\s*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "effort_hours",
        "capability",
        "attempts",
        "status",
        "links"
      ],
      "type": "object"
    },
    "ResourceIdentity": {
      "description": "Stable identity for one typed HTML resource.",
      "properties": {
        "project": {
          "type": "string"
        },
        "type": {
          "enum": [
            "plan",
            "research",
            "evidence",
            "sprint",
            "milestone",
            "blocker",
            "timeline",
            "project"
          ],
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "archived": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "project",
        "type",
        "slug"
      ],
      "type": "object"
    }
  },
  "description": "Typed contract for a single plan's state.\n\n``extra='ignore'`` on read so unknown attrs/metas drop cleanly. The\ncanonical dump (:meth:`canonical_dump`) reproduces the read_state dict\nshape byte-for-byte through write_state.",
  "properties": {
    "project": {
      "default": "",
      "description": "docs-project meta; required-on-write",
      "type": "string"
    },
    "type": {
      "default": "plan",
      "enum": [
        "plan",
        "research",
        "evidence"
      ],
      "type": "string"
    },
    "slug": {
      "default": "",
      "type": "string"
    },
    "title": {
      "default": "",
      "type": "string"
    },
    "summary": {
      "default": "",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "pending",
        "active",
        "in-progress",
        "blocked",
        "shipped",
        "done",
        "superseded",
        "abandoned",
        "archived",
        "historical",
        "reference"
      ],
      "type": "string"
    },
    "roi": {
      "default": "mid",
      "enum": [
        "high",
        "mid",
        "low"
      ],
      "type": "string"
    },
    "effort_hours": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "multipleOf": 0.25,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Neutral worker-hours from the plan-effort-hours meta"
    },
    "wall_clock_hours": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "multipleOf": 0.25,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Elapsed hours from the plan-wall-clock-hours meta, assuming the maximum parallelism the plan itself supports. Never exceeds effort_hours; equals it for strictly sequential work."
    },
    "effort_calibrated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Whether worker-hours were authored rather than mapped from a letter",
      "readOnly": true
    },
    "effort": {
      "default": "M",
      "deprecated": true,
      "description": "Deprecated compatibility input; use effort_hours",
      "enum": [
        "S",
        "M",
        "L",
        "XL"
      ],
      "type": "string"
    },
    "milestone": {
      "default": "",
      "description": "Milestone identifier, or empty when unassigned",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "type": "string"
    },
    "sprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Sprint ref this plan belongs to. Bare 'id' = same-project; 'project:id' = external (cross-project)."
    },
    "graph_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stable ship-target handle carried by this endpoint plan. Membership is always derived from depends_on and is never stored.",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*)?$"
    },
    "north_star": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "capability": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilityRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tier": {
      "default": "",
      "deprecated": true,
      "description": "Deprecated compatibility input; use capability",
      "type": "string"
    },
    "owner": {
      "default": "",
      "type": "string"
    },
    "section_declarations": {
      "additionalProperties": {
        "enum": [
          "implementable",
          "deferred",
          "done"
        ],
        "type": "string"
      },
      "description": "DAG-build classification keyed by authored section identity; only implementable entries form the executable denominator",
      "type": "object"
    },
    "sections": {
      "description": "Opt-in typed records beside the section declaration map",
      "items": {
        "$ref": "#/$defs/SectionRecord"
      },
      "type": "array"
    },
    "archived": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "read": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reviewed_at": {
      "default": "",
      "type": "string"
    },
    "recorded_at": {
      "default": "",
      "type": "string"
    },
    "verdict": {
      "default": "",
      "type": "string"
    },
    "environment": {
      "default": "",
      "type": "string"
    },
    "source": {
      "default": "",
      "type": "string"
    },
    "source_quality": {
      "default": "",
      "type": "string"
    },
    "depends_on": {
      "description": "Plan refs this plan depends on. Bare 'slug' = same-project; 'project:slug' = external (cross-project); optional '#stage'.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "blocks": {
      "description": "Plan refs this plan blocks. Same grammar as depends_on: bare 'slug' = same-project; 'project:slug' = external; optional '#stage'.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "after": {
      "description": "Soft sequencing refs: this plan would rather start after them, and must not be held when they have not shipped. Same grammar as depends_on: bare 'slug' = same-project; 'project:slug' = external; optional '#stage'. Unlike depends_on it never blocks: the roadmap orders and annotates ready work with it.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "informs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "evidence_for": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "verifies": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "supersedes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "commits": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "artifacts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tags": {
      "description": "Canonical topical identities carried by this resource",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "standalone": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "One-sentence reason this plan genuinely stands alone \u2014 it waits on no other plan and feeds none. Persisted as <meta name=\"plan-standalone\">. Absent means the plan must declare depends_on, blocks, informs or a gate."
    },
    "modified": {
      "default": "",
      "type": "string"
    },
    "impl": {
      "default": 0.0,
      "type": "number"
    },
    "version": {
      "default": 0,
      "type": "integer"
    },
    "compatibility_warnings": {
      "items": {
        "type": "string"
      },
      "readOnly": true,
      "type": "array"
    },
    "validation_diagnostics": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "readOnly": true,
      "type": "array"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/Gate"
      },
      "type": "array"
    },
    "decisions": {
      "additionalProperties": {
        "$ref": "#/$defs/Decision"
      },
      "type": "object"
    },
    "followups": {
      "items": {
        "$ref": "#/$defs/Followup"
      },
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "type": "array"
    },
    "research": {
      "items": {
        "$ref": "#/$defs/ResearchItem"
      },
      "type": "array"
    },
    "comments": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Comment"
        },
        "type": "array"
      },
      "type": "object"
    }
  },
  "type": "object",
  "$id": "https://reckon/schema/plan/3.0/plan.schema.json",
  "schemaVersion": "3.0",
  "title": "reckon PlanState"
}
