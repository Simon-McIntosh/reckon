#!/usr/bin/env bash
#
# Session host entry point. Claude Code starts this as a plugin monitor for the
# whole session. It names a node-local FIFO for its owner -- the Claude process
# named by CLAUDE_PID together with that process's start time, a pair that
# survives /clear where the session id does not -- and replaces itself at once
# (same pid, same stdout) with `reckon crew host`, handing the host that open
# descriptor and no first request. Waiting on the FIFO for a first request
# before executing the host left a re-armed session with live runs and no new
# dispatch showing an empty pane indefinitely: a request arrives only with a
# dispatch, so nothing ever executed the host. The host reads its owner's
# session on start and follows the live runs that session already owns, then
# serves the FIFO. The descriptor stays open across exec, so a request written
# in the gap waits in the pipe rather than being lost.
set -u

owner_pid="${CLAUDE_PID:-}"
[ -n "$owner_pid" ] || exit 0
[ -r "/proc/$owner_pid/stat" ] || exit 0

# Field 22 of /proc/<pid>/stat is the process start time. The comm field
# (field 2) may hold spaces and parentheses, so strip through the last ") "
# before counting fields.
owner_start="$(sed 's/^.*) //' "/proc/$owner_pid/stat" | awk '{print $20}')"
[ -n "$owner_start" ] || exit 0

if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  runtime="$XDG_RUNTIME_DIR"
elif [ -d "/run/user/$(id -u)" ]; then
  runtime="/run/user/$(id -u)"
elif [ -n "${TMPDIR:-}" ]; then
  runtime="$TMPDIR"
else
  exit 0
fi

state_dir="$runtime/reckon-session-host"
mkdir -p "$state_dir" || exit 0
fifo="$state_dir/$owner_pid-$owner_start.fifo"

# Remove the FIFO if this shell is stopped in the short window before the exec
# below. The trap is gone the moment the exec replaces this shell with the host:
# from then on the host owns removal, on a signal and on its owner's end alike.
trap 'rm -f "$fifo"; exit 0' TERM HUP INT

[ -p "$fifo" ] || mkfifo "$fifo" || exit 0

# Open once, read-write, so the open does not block on a writer and a request
# written before the exec waits in the pipe.
exec 3<>"$fifo" || { rm -f "$fifo"; exit 0; }

script_path="$(readlink -f "$0")"
checkout="$(cd "$(dirname "$script_path")/../../.." && pwd)"
exec "$checkout/.venv/bin/reckon" crew host \
  --owner-pid "$owner_pid" \
  --owner-start "$owner_start" \
  --fd 3