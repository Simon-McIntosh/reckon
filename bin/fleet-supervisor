#!/bin/bash
# fleet-supervisor — the fleet allocation's batch step.
#
# A step started with srun ends when its login-side client does, so the batch
# step is the only process tree on the fleet node that outlives every login
# node and every session step. The zellij servers holding the agent sessions,
# the node sampler, and the per-run supervisors holding crew workers are all
# started from it.
#
# The implementation is reckon/crew/fleet_supervisor.py. This file runs it with
# this checkout's own interpreter and passes its arguments through: none for
# the request loop, `start <session> [layout]` for one session start.
set -eu

self_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
repo_root=$(CDPATH= cd -- "$self_dir/.." && pwd)

PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}" \
  exec "$repo_root/.venv/bin/python" -m reckon.crew.fleet_supervisor "$@"
