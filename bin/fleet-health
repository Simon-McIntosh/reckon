#!/bin/bash
# fleet-health — sample the fleet node once a minute, onto shared storage.
#
# Started by fleet-supervisor inside the allocation's batch step. A separate
# --scheduler reader appends scheduler rows after that allocation ends. Samples go to
# GPFS, not the node: when the node is declared failed the node-local state is
# gone and SSH to it is refused, so the minutes before a failure survive only
# if they were written somewhere else as they happened.
#
# SLURM declares a node failed when its slurmd does not answer the controller
# for SlurmdTimeout (30 s on this cluster). The columns are the ones that tell
# the failed kill apart from the D-state storm that followed it: memory
# headroom and the job's own cgroup use (memory pressure), blocked tasks and a
# timed stat of $HOME (a GPFS stall), the time the local slurmd takes to answer
# (slurmd itself), and a controller ping (the network path).
#
# Thresholds mark pressure. The task columns name a spawn leak while it
# grows: this user's task count (what RLIMIT_NPROC counts), how many of them
# are Python interpreters, and the process with the most children. A node-wide
# D-state count and the one-minute load catch a stall that crosses no other
# threshold — the failed kill and the D-state storm crossed none of the three
# counters. Each threshold is overridable by environment variable. When any
# trigger fires, the full process table is written beside the samples with
# each process's thread count and wait channel, followed by every D-state
# process on the node whoever owns it, because a stall is often in another
# user's process or a kernel thread. An alert is raised at most once per ten
# minutes. A rising cgroup kill count always retains a table and a dated
# alert, even inside that interval. A kernel OOM report lists each process's memory but not its parent
# or command line, so without that table a leak can be measured and not named.
#
# One file per job and node; a second copy for the same job and node exits.
#
# Each pass publishes the disk reading before it does anything else, the
# scratch sweep — the pass's most expensive step — runs after the row is
# written, and every step of a pass is clamped to what is left of the pass
# bound. Published readings are what the reader's freshness limit measures, so
# the guarantee is: while the sampler is alive, consecutive readings are
# separated by the wait plus the pass bound — the wait plus 60 seconds by
# default, whatever this node's load makes of any individual step.
set -uo pipefail

self_dir=$(dirname -- "$(readlink -f -- "$0")")
repo_root=$(dirname -- "$self_dir")
export PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}"
health_python="$repo_root/.venv/bin/python"

if [ "${1:-}" = --scheduler ]; then
    exec "$health_python" -m reckon.crew.fleet_node "$@"
fi

once=0
passes=0
case "${1:-}" in
    --once) once=1 ;;
    --passes) passes="${2:-0}" ;;
esac
sleep_secs="${FLEET_SLEEP_SECONDS:-60}"
snapshot_interval="${FLEET_SNAPSHOT_INTERVAL:-600}"
# One bound for every step a pass takes, and one for the reading itself, so a
# pass's worst case is the sum of the bounds rather than whatever a loaded node
# makes of them. The reading is published before any other step, which is what
# keeps consecutive readings inside the reader's freshness limit when each other
# step reaches its bound. Both are overridable so a test can drive a pass at a
# scale a session can wait for.
step_bound="${FLEET_STEP_BOUND_SECONDS:-20}"
disk_bound="${FLEET_DISK_BOUND_SECONDS:-15}"
# A pass is one bounded unit. Its steps are clamped to what is left of this
# budget, so the reading a pass publishes is at most this bound plus the wait
# after the previous one, whatever each step individually would have taken.
# 90 seconds against a 60-second wait sits inside the 180-second freshness
# limit the readers apply with room for the row append.
pass_bound="${FLEET_PASS_BOUND_SECONDS:-90}"
# Named in the reading, so a reading that goes stale can be attributed to the
# process that last published one.
export FLEET_HEALTH_SAMPLER_PID=$$

: "${SLURM_JOB_ID:?fleet-health runs inside the fleet allocation}"
node=$(hostname -s)
state="${FLEET_STATE_DIR:-$HOME/.local/state/fleet}"
dir="$state/health"
mkdir -p "$dir"
out="$dir/${SLURM_JOB_ID}-${node}.tsv"
lock="${XDG_RUNTIME_DIR:-/tmp/$(id -u)-fleet}/fleet-health.lock"
mkdir -p "$(dirname "$lock")"
exec 9>"$lock"
flock -n 9 || exit 0

# Thresholds for the process-table snapshot. A full fleet runs about 2,500
# tasks and a few dozen Python processes; the two leaks measured on this
# fleet each reached about 7,500 Python processes before the node failed.
TASKS_ALERT="${FLEET_TASKS_ALERT:-4000}"
PYTHON_ALERT="${FLEET_PYTHON_ALERT:-1000}"
MEM_AVAIL_ALERT_MB="${FLEET_MEM_AVAIL_ALERT_MB:-12000}"
# A healthy node carries a handful of D-state tasks and a one-minute load
# near its core count; a stall drives both up. Both are node-wide and cheaper
# than the leak counters, so they catch pressure those counters never see.
DSTATE_ALERT="${FLEET_DSTATE_ALERT:-50}"
LOAD_ALERT="${FLEET_LOAD_ALERT:-56}"

# The reading paths are overridable so one pass can be driven against fixtures
# without touching the node's own /proc or cgroup.
procdir="${FLEET_PROC_DIR:-/proc}"
cgdir="${FLEET_CGROUP_DIR:-}"
if [ -z "$cgdir" ]; then
    cg=$(sed -n 's/^0:://p' "$procdir/self/cgroup" | sed -E 's#/step_[^/]+.*##')
    cgdir="/sys/fs/cgroup$cg"
fi

ms_since() { echo $(( ($(date +%s%N) - $1) / 1000000 )); }
bounded() {
    # Run one step under its own bound or what the pass has left, whichever is
    # shorter. A pass that has spent its budget runs no further step: it reports
    # the step's unknown value and leaves the rest of the row to the next pass,
    # which is what keeps the pass, and so the reading, bounded.
    local want=$1 left
    shift
    left=$(( pass_end - $(date +%s) ))
    [ "$left" -le 0 ] && return 124
    [ "$left" -lt "$want" ] && want=$left
    timeout "$want" "$@"
}
over_load() { awk -v l="$1" -v t="$2" 'BEGIN { exit !(l > t) }'; }

# Both writers take the file server's record lock, which holds across nodes.
"$health_python" -m reckon.crew.fleet_node --initialise-series "$out" || exit 1

# Resume the last readable count so restarting the sampler does not hide a kill.
last_kills=$(awk -F '\t' '
    NR == 1 {for (i=1; i<=NF; i++) if ($i == "job_oom_kill") column=i; next}
    column && $column ~ /^[0-9]+$/ {n=$column}
    END {print n}' "$out")
last_snapshot=0
count=0
while :; do
    pass_end=$(( $(date +%s) + pass_bound ))
    # The reading first: every other step below may reach its bound, and a
    # reading published at the end of that queue is what left this node's
    # published reading outside its freshness limit under load.
    disk=$(bounded "$disk_bound" "${FLEET_DISK_PYTHON:-${RECKON_SHIM_PYTHON:-$health_python}}" -m reckon.crew.fleet_supervisor sample-node-disk) || disk="unknown unknown unknown unknown"
    read -r disk_total disk_used disk_free disk_inodes <<<"$disk"
    session_scratch=$(bounded "$step_bound" "${RECKON_SHIM_PYTHON:-$health_python}" -m reckon.crew.fleet_supervisor sample-session-scratch) || session_scratch=unknown
    writable_interpreters=$(bounded "$step_bound" "${RECKON_SHIM_PYTHON:-$health_python}" -m reckon.crew.fleet_supervisor check-interpreters) || writable_interpreters=unknown
    test_sample=$(bounded "$step_bound" "${RECKON_SHIM_PYTHON:-$health_python}" -m reckon.crew.fleet_supervisor sample-test-processes) || test_sample=$'unknown\tunknown\t[]'
    IFS=$'\t' read -r test_trees test_rss test_runs <<< "$test_sample"
    test_rss=${test_rss:-unknown}
    test_runs=${test_runs:-[]}
    read -r load1 load5 _ < "$procdir/loadavg"
    running=$(awk '/^procs_running/ {print $2}' "$procdir/stat")
    blocked=$(awk '/^procs_blocked/ {print $2}' "$procdir/stat")
    dstate=$(ps -eo stat= 2>/dev/null | grep -c '^D')
    avail=$(awk '/^MemAvailable:/ {printf "%d", $2/1024}' "$procdir/meminfo")
    swap=$(awk '/^SwapFree:/ {printf "%d", $2/1024}' "$procdir/meminfo")
    jobmem=$(awk '{printf "%d", $1/1048576}' "$cgdir/memory.current" 2>/dev/null || echo -)
    jobmax=$(awk '$1 ~ /^[0-9]+$/ {printf "%d", $1/1048576; next} {print $1}' "$cgdir/memory.max" 2>/dev/null || echo -)
    kills=$(awk '$1 == "oom_kill" && $2 ~ /^[0-9]+$/ {print $2; found=1; exit}
        END {if (!found) print "-"}' "$cgdir/memory.events" 2>/dev/null) || kills=-
    kill_rise=0
    if [[ "$kills" =~ ^[0-9]+$ ]]; then
        if [[ "$last_kills" =~ ^[0-9]+$ ]] && [ "$kills" -gt "$last_kills" ]; then
            kill_rise=$((kills - last_kills))
        fi
    fi
    t=$(date +%s%N); bounded "$step_bound" stat "$HOME" >/dev/null 2>&1 && home=$(ms_since "$t") || home=timeout
    t=$(date +%s%N); bounded "$step_bound" scontrol show slurmd >/dev/null 2>&1 && slurmd=$(ms_since "$t") || slurmd=timeout
    ping=$(bounded "$step_bound" scontrol ping 2>/dev/null | grep -oE 'UP|DOWN' | head -1)
    tasks=$(bounded "$step_bound" ps -L -u "$USER" --no-headers 2>/dev/null | wc -l)
    table=$(bounded "$step_bound" ps -u "$USER" -o pid=,ppid=,comm= 2>/dev/null)
    python=$(awk '$3 ~ /^python/' <<<"$table" | wc -l)
    read -r top_n top_pid < <(awk '{print $2}' <<<"$table" | sort | uniq -c | sort -rn | head -1)
    top_args=$(ps -o args= -p "${top_pid:-0}" 2>/dev/null | tr -d '\t\n' | cut -c1-80)
    top="${top_n:-0}:${top_pid:--}:${top_args:--}"
    now=$(date -u +%FT%TZ)
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t-\t-\t-\t-\tnode\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$now" \
        "$load1" "$load5" "$running" "$blocked" "$dstate" "$avail" "$swap" \
        "$jobmem" "$jobmax" "$home" "$slurmd" "${ping:-none}" "$tasks" "$python" "$top" "$writable_interpreters" "$kills" "$SLURM_JOB_ID" "$node" "$session_scratch" "$test_trees" "$test_rss" "$test_runs" \
        "${disk_total:-unknown}" "${disk_used:-unknown}" "${disk_free:-unknown}" "${disk_inodes:-unknown}" \
        | "$health_python" -m reckon.crew.fleet_node --append-node-row "$out" || exit 1

    reason=""
    if [[ "$test_trees" =~ ^[0-9]+$ ]] && [ "$test_trees" -gt 0 ]; then
        reason="$test_trees test trees ($test_rss resident bytes): $test_runs"
    fi
    [ "$tasks" -gt "$TASKS_ALERT" ] && reason="${reason:+$reason, }$tasks tasks"
    [ "$python" -gt "$PYTHON_ALERT" ] && reason="${reason:+$reason, }$python python processes"
    [ "${avail:-0}" -lt "$MEM_AVAIL_ALERT_MB" ] && reason="${reason:+$reason, }${avail} MB available"
    [ "${dstate:-0}" -gt "$DSTATE_ALERT" ] && reason="${reason:+$reason, }$dstate D-state processes"
    over_load "${load1:-0}" "$LOAD_ALERT" && reason="${reason:+$reason, }load $load1"
    if [ "$kill_rise" -gt 0 ]; then
        reason="${reason:+$reason, }$kill_rise memory kills ($last_kills -> $kills)"
    fi
    if [ "$kill_rise" -gt 0 ] || { [ -n "$reason" ] && [ $(( $(date +%s) - last_snapshot )) -ge "$snapshot_interval" ]; }; then
        last_snapshot=$(date +%s)
        snap="$dir/${SLURM_JOB_ID}-${node}-$(date -u +%Y%m%dT%H%M%S%NZ).ps"
        {
            printf '%s\n' "# per-process thread count and wait channel, $now"
            timeout 30 ps -u "$USER" --sort=-rss -o pid,ppid,pgid,etimes,rss,nlwp,wchan:32,stat,comm,args
            printf '%s\n' "# node-wide D-state processes, whoever owns them, $now"
            timeout 30 ps -eo pid,ppid,user,etimes,nlwp,wchan:32,stat,comm,args 2>/dev/null \
                | awk 'NR==1 || $7 ~ /^D/'
        } > "$snap" 2>&1
        largest=$(awk '/^# node-wide/ {exit}
            $1 ~ /^[0-9]+$/ {printf "%s%s KiB %s (pid %s)", sep, $5, $9, $1
                sep="; "; if (++n == 5) exit}' "$snap")
        msg="$now fleet job $SLURM_JOB_ID node $node under pressure: $reason. Busiest parent $top. Largest processes: ${largest:-unknown}. Process table: $snap"
        printf '%s\n' "$msg" >> "$state/alerts.log"
        printf '%s\n' "$msg" > "$state/notice"
    fi
    [[ "$kills" =~ ^[0-9]+$ ]] && last_kills="$kills"
    # The scratch sweep is the pass's most expensive step and the one that
    # outran its bound on a loaded node. It runs here, after the reading and
    # the row are written, so a pass that spends its whole bound here has
    # already published.
    bounded "$step_bound" "${RECKON_SHIM_PYTHON:-$health_python}" -m reckon.crew.fleet_supervisor reclaim-node-scratch >/dev/null 2>&1 || true
    count=$((count + 1))
    [ "$once" -eq 1 ] && break
    [ "$passes" -gt 0 ] && [ "$count" -ge "$passes" ] && break
    sleep "$sleep_secs"
done
