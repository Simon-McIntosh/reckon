#!/bin/sh
# reckon-shim: a PATH lookup skips any file carrying this token, so no shim
# resolves to another checkout's shim (reckon/shim_lookup.py).
# A thin git shim: refuse a mutating git verb aimed at a repository that is not
# this run's own worktree.
#
# The decision lives in reckon/worker_git_shim.py, which asks the real git which
# repository one invocation resolves to rather than parsing the command text.
# This file only resolves an interpreter that can import the package and passes
# its argv through; it launches nothing itself and rewrites nothing.
set -eu

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$self_dir/../.." && pwd)

# The package needs Python 3.12. A bare `python3` on PATH is often an older
# system interpreter that cannot even parse the package, so prefer the repo's
# own environment and an explicit 3.12 before falling back.
interpreter=
for candidate in \
  "${RECKON_SHIM_PYTHON:-}" \
  "$repo_root/.venv/bin/python" \
  "$(command -v python3.12 || true)" \
  "$(command -v python3 || true)"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    interpreter=$candidate
    break
  fi
done

if [ -z "$interpreter" ]; then
  echo "git shim: no Python 3.12+ interpreter found; set RECKON_SHIM_PYTHON" >&2
  exit 127
fi

# Start reckon's interpreter with only reckon's import root on its path, and no
# user site (-s). A job that ran `module load` puts its own site-packages on
# PYTHONPATH, and appending the caller's PYTHONPATH would let a 3.11 copy of a
# dependency shadow the one in reckon's own environment, breaking the import
# before git is reached. The caller's interpreter-path variables are set aside
# under RECKON_SHIM_CALLER_* and put back by the module before it runs the real
# program, which still receives the caller's environment unchanged.
# -P keeps the working directory off sys.path, so the package imported is the
# one this shim belongs to rather than whatever checkout happens to be the cwd.
if [ "${PYTHONPATH+set}" = set ]; then
  RECKON_SHIM_CALLER_PYTHONPATH=$PYTHONPATH
  export RECKON_SHIM_CALLER_PYTHONPATH
fi
if [ "${PYTHONHOME+set}" = set ]; then
  RECKON_SHIM_CALLER_PYTHONHOME=$PYTHONHOME
  export RECKON_SHIM_CALLER_PYTHONHOME
fi
if [ "${PYTHONSTARTUP+set}" = set ]; then
  RECKON_SHIM_CALLER_PYTHONSTARTUP=$PYTHONSTARTUP
  export RECKON_SHIM_CALLER_PYTHONSTARTUP
fi
unset PYTHONPATH PYTHONHOME PYTHONSTARTUP

PYTHONPATH="$repo_root" \
  exec "$interpreter" -P -s -c '
import sys

from reckon.worker_git_shim import main

raise SystemExit(main(sys.argv[1:]))
' "$@"