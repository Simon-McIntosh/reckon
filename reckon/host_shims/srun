#!/bin/sh
# reckon-shim: a PATH lookup skips any file carrying this token, so no shim
# resolves to another checkout's shim (reckon/shim_lookup.py).
# A thin srun shim: refuse an implicit nested launch from inside the held job.
#
# The decision lives in reckon/nested_launch.py, which reads the process's own
# cgroup line through reckon.host.host_facts. This file only resolves an
# interpreter that can import the package and passes its own name and argv
# through: the tool is the file's basename, so the same body serves srun,
# sbatch and salloc. It launches nothing itself.
set -eu

tool=$(basename -- "$0")
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$self_dir/../.." && pwd)

# The package needs Python 3.12. A bare `python3` on PATH is often an older
# system interpreter that cannot even parse the package, so prefer the repo's
# own environment and an explicit 3.12 before falling back.
interpreter=
for candidate in \
  "${RECKON_SHIM_PYTHON:-}" \
  "$repo_root/.venv/bin/python" \
  "$(command -v python3.12 || true)" \
  "$(command -v python3 || true)"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    interpreter=$candidate
    break
  fi
done

if [ -z "$interpreter" ]; then
  echo "$tool shim: no Python 3.12+ interpreter found; set RECKON_SHIM_PYTHON" >&2
  exit 127
fi

# Only reckon's import root is on the interpreter's PYTHONPATH, and the user
# site (-s) and working directory (-P) are dropped: a job that ran `module
# load` puts another Python's site-packages on PYTHONPATH, and left ahead of
# reckon's own packages a 3.11 copy of a dependency shadows the one reckon
# needs, breaking the import before the scheduler command is reached. The
# caller's interpreter-path variables are parked under RECKON_SHIM_CALLER_*
# here: the module hands them back to the scheduler command the shim runs, and
# the bootstrap below appends the caller's PYTHONPATH after reckon's own
# packages, so a caller's sitecustomize still runs while its packages cannot
# shadow reckon's.
if [ "${PYTHONPATH+set}" = set ]; then
  RECKON_SHIM_CALLER_PYTHONPATH=$PYTHONPATH
  export RECKON_SHIM_CALLER_PYTHONPATH
fi
if [ "${PYTHONHOME+set}" = set ]; then
  RECKON_SHIM_CALLER_PYTHONHOME=$PYTHONHOME
  export RECKON_SHIM_CALLER_PYTHONHOME
fi
if [ "${PYTHONSTARTUP+set}" = set ]; then
  RECKON_SHIM_CALLER_PYTHONSTARTUP=$PYTHONSTARTUP
  export RECKON_SHIM_CALLER_PYTHONSTARTUP
fi
unset PYTHONPATH PYTHONHOME PYTHONSTARTUP

PYTHONPATH="$repo_root" \
  exec "$interpreter" -P -s -c '
import os
import sys

_extra = os.environ.get("RECKON_SHIM_CALLER_PYTHONPATH", "")
if _extra:
    sys.path.extend(_part for _part in _extra.split(os.pathsep) if _part)
    try:
        import sitecustomize  # noqa: F401
    except ModuleNotFoundError:
        pass

from reckon.nested_launch import main

raise SystemExit(main(sys.argv[1], sys.argv[2:]))
' "$tool" "$@"