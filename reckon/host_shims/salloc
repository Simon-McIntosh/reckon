#!/bin/sh
# A thin srun shim: refuse an implicit nested launch from inside the held job.
#
# The decision lives in reckon/nested_launch.py, which reads the process's own
# cgroup line through reckon.host.host_facts. This file only resolves an
# interpreter that can import the package and passes its own name and argv
# through: the tool is the file's basename, so the same body serves srun,
# sbatch and salloc. It launches nothing itself.
set -eu

tool=$(basename -- "$0")
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$self_dir/../.." && pwd)

# The package needs Python 3.12. A bare `python3` on PATH is often an older
# system interpreter that cannot even parse the package, so prefer the repo's
# own environment and an explicit 3.12 before falling back.
interpreter=
for candidate in \
  "${RECKON_SHIM_PYTHON:-}" \
  "$repo_root/.venv/bin/python" \
  "$(command -v python3.12 || true)" \
  "$(command -v python3 || true)"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    interpreter=$candidate
    break
  fi
done

if [ -z "$interpreter" ]; then
  echo "$tool shim: no Python 3.12+ interpreter found; set RECKON_SHIM_PYTHON" >&2
  exit 127
fi

PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}" \
  exec "$interpreter" -c '
import sys

from reckon.nested_launch import main

raise SystemExit(main(sys.argv[1], sys.argv[2:]))
' "$tool" "$@"